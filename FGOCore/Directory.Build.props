<Project>
    <PropertyGroup>
        <!-- Megadot current version is 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->
        <!-- MegaDot / Godot 4.5.1 mono executable used for export-pack when publishing -->
        <GodotPath>F:/Programs/SlayTheSpire2-SmashFromFGO/MegaDot/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>

        <!-- El juego que se corre es la copia en F:\Games (NO el install de Steam) — se fija el path para
             que build/publish vayan SOLOS al folder de mods correcto. Machine-local (Directory.Build.props gitignorado). -->
        <Sts2Path>C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
    </PropertyGroup>
</Project>