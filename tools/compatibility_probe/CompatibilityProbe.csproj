<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Sts2Compatibility.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(RitsuLibPackageId)"
                      Version="$(RitsuLibPackageVersion)"
                      PrivateAssets="All"
                      ExcludeAssets="contentFiles;build;buildTransitive;analyzers" />
  </ItemGroup>

  <Target Name="RemoveTransitiveGodotGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Godot.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
