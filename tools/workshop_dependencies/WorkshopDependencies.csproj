<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>$(SteamworksDir)\Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(SteamworksDir)\steam_api64.dll"
          Link="steam_api64.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateSteamworksDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SteamworksDir)' == ''"
           Text="Pass -p:SteamworksDir=&lt;directory containing Steamworks.NET.dll and steam_api64.dll&gt;." />
    <Error Condition="!Exists('$(SteamworksDir)\Steamworks.NET.dll')"
           Text="Steamworks.NET.dll was not found under $(SteamworksDir)." />
    <Error Condition="!Exists('$(SteamworksDir)\steam_api64.dll')"
           Text="steam_api64.dll was not found under $(SteamworksDir)." />
  </Target>
</Project>
